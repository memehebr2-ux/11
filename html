<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>discord.gg/uaee</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&display=swap');

        body {
            margin: 0;
            padding: 0;
            background-color: #000000;
            font-family: 'Share Tech Mono', monospace;
            color: #ff0000;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            flex-direction: column;
            text-align: center;
            overflow: hidden;
            position: relative;
        }

        /* فيديو الخلفية بوضوح كامل وإضاءة أصلية */
        .video-background {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: -3;
            overflow: hidden;
        }

        .video-background video {
            width: 100%;
            height: 100%;
            object-fit: cover;
            opacity: 1; /* وضوح تام 100% لإظهار الوجه */
        }

        /* طبقة عتمة خفيفة جداً حول الأطراف فقط */
        body::before {
            content: '';
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: radial-gradient(circle at center, rgba(0, 0, 0, 0.15) 0%, rgba(0, 0, 0, 0.5) 100%);
            pointer-events: none;
            z-index: -2;
        }

        /* خطوط CRT خفيفة وشفافة */
        body::after {
            content: " ";
            display: block;
            position: absolute;
            top: 0; left: 0; bottom: 0; right: 0;
            background: linear-gradient(rgba(18, 0, 0, 0) 50%, rgba(0, 0, 0, 0.4) 50%);
            z-index: 10;
            background-size: 100% 3px;
            pointer-events: none;
        }

        /* المربع الرئيسي بكامل الشفافية */
        .container {
            z-index: 5;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 30px 40px;
            border-radius: 12px;
            background: rgba(0, 0, 0, 0.35); /* خلفية خفيفة جداً لا تحجب ما خلفها */
            border: 1px solid rgba(255, 0, 0, 0.6);
            box-shadow: 0 0 25px rgba(255, 0, 0, 0.3), inset 0 0 15px rgba(255, 0, 0, 0.15);
            max-width: 550px;
            width: 90%;
        }

        .header-text {
            font-size: 1.8em;
            color: #ff1a1a;
            text-shadow: 0 0 10px #ff0000, 0 0 20px #8b0000;
            margin-bottom: 5px;
            letter-spacing: 2.5px;
            font-weight: bold;
            text-transform: uppercase;
        }

        .discord-link {
            font-size: 1em;
            color: #ff4d4d;
            text-shadow: 0 0 8px #ff0000;
            letter-spacing: 2px;
            margin-bottom: 25px;
        }

        .info {
            font-size: 0.95em;
            color: #ff5555;
            background: rgba(0, 0, 0, 0.45); /* شفافية عالية داخل مربع المعلومات */
            border: 1px dashed rgba(255, 0, 0, 0.5);
            padding: 16px 22px;
            border-radius: 6px;
            text-shadow: 0px 0px 8px rgba(255, 0, 0, 0.8);
            letter-spacing: 1px;
            line-height: 1.6;
            text-align: left;
            width: 100%;
            box-sizing: border-box;
        }

        .info strong {
            color: #ff0000;
        }

        .warning-text {
            margin-top: 25px;
            font-size: 1.25em;
            color: #ff1a1a;
            text-shadow: 0px 0px 10px #ff0000, 0px 0px 20px #8b0000;
            letter-spacing: 2px;
            font-weight: bold;
            text-transform: uppercase;
        }
    </style>
</head>
<body>

    <!-- فيديو الخلفية المباشر -->
    <div class="video-background">
        <video id="bg-video" autoplay loop playsinline>
            <source src="https://files.catbox.moe/786ys5.mp4" type="video/mp4">
            Your browser does not support HTML5 video.
        </video>
    </div>

    <div class="container">
        <div class="header-text">
            HACKED BY [[ ALSHAIB🔞 ]]
        </div>
        <div class="discord-link">
            discord.gg/uaee
        </div>

        <div class="info" id="ip-info">
            <strong>YOUR IP ADDRESS:</strong> Fetching...<br>
            <strong>YOUR IP INFO:</strong><br>
            <span>Loading...</span>
        </div>

        <div class="warning-text">OOPS, YOUR SERVER IS DOWN!</div>
    </div>

    <script>
        fetch('https://ipinfo.io/json')
        .then(response => response.json())
        .then(data => {
            delete data.readme;
            const infoDiv = document.getElementById('ip-info');
            infoDiv.innerHTML = `
                <strong>YOUR IP ADDRESS:</strong> ${data.ip || 'N/A'}<br>
                <strong>YOUR IP INFO:</strong><br>
                City: ${data.city || 'N/A'}<br>
                Region: ${data.region || 'N/A'}<br>
                Country: ${data.country || 'N/A'}<br>
                Location: ${data.loc || 'N/A'}<br>
                Org: ${data.org || 'N/A'}<br>
                Timezone: ${data.timezone || 'N/A'}
            `;
        })
        .catch(error => {
            document.getElementById('ip-info').innerHTML = "<strong>Failed to load IP data.</strong>";
        });

        // تشغيل الصوت والفيديو مباشرة بضغطة واحدة لتجاوز حظر المتصفح
        document.body.addEventListener('click', () => {
            const video = document.getElementById('bg-video');
            video.muted = false;
            video.play();
        }, { once: true });
    </script>
</body>
</html>
